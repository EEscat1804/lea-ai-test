# Shared service token verified on every incoming request.
# lea-be-core sends `Authorization: Bearer <token>`; lea-ai compares.
# Set via `wrangler secret put SERVICE_TOKEN` per environment.
SERVICE_TOKEN=replace-me

# Gemini API key — used for prompt orchestration that calls Gemini directly
# (e.g., guardrail classifier). lea-be-core retains its own key for chat;
# this one is scoped to lea-ai's own model calls.
GEMINI_API_KEY=replace-me
